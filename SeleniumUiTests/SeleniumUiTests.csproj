<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- ডুপ্লিকেট অ্যাট্রিবিউট এরর চিরতরে বন্ধ করার জন্য নিচের লাইনটি যোগ করা হয়েছে -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo> 
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <!-- সেলেনিয়ামের মূল প্যাকেজসমূহ -->
    <PackageReference Include="Selenium.WebDriver" Version="4.16.0" />
    <PackageReference Include="Selenium.Support" Version="4.16.0" />
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="120.0.6099.10900" />
  </ItemGroup>

</Project>
